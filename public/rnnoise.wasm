const audioContext = new AudioContext();

async function setupAudioProcessing() {
  // Load the RNNoise processor module
  await audioContext.audioWorklet.addModule('/rnnoise-processor.js');

  // Get user's microphone input
  const stream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
  const source = audioContext.createMediaStreamSource(stream);

  // Create the RNNoise AudioWorkletNode
  const rnnoiseNode = new AudioWorkletNode(audioContext, 'rnnoise-processor');

  // Connect the nodes
  source.connect(rnnoiseNode);
  rnnoiseNode.connect(audioContext.destination);

  // Use the processed stream for further processing or transmission
  const destination = audioContext.createMediaStreamDestination();
  rnnoiseNode.connect(destination);
  const processedStream = destination.stream;

  // Proceed with using processedStream in your application
  // For example, send it via WebRTC or PeerJS
}

setupAudioProcessing();
